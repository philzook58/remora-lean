// Handwritten target, not yet generated by Remora.
// A[M,K] * B[K,N], then bias[N] and ReLU. Scheduling is deliberately separate.
module {
  func.func @main(%a: tensor<2x3xf32>, %b: tensor<3x2xf32>,
                  %bias: tensor<2xf32>) -> tensor<2x2xf32> {
    %zero = arith.constant 0.0 : f32
    %empty = tensor.empty() : tensor<2x2xf32>
    %init = linalg.fill ins(%zero : f32) outs(%empty : tensor<2x2xf32>)
      -> tensor<2x2xf32>
    %product = linalg.matmul ins(%a, %b : tensor<2x3xf32>, tensor<3x2xf32>)
      outs(%init : tensor<2x2xf32>) -> tensor<2x2xf32>
    %dest = tensor.empty() : tensor<2x2xf32>
    %result = linalg.generic {
      indexing_maps = [affine_map<(m,n)->(m,n)>, affine_map<(m,n)->(n)>,
                       affine_map<(m,n)->(m,n)>],
      iterator_types = ["parallel", "parallel"]
    } ins(%product, %bias : tensor<2x2xf32>, tensor<2xf32>)
      outs(%dest : tensor<2x2xf32>) {
    ^bb0(%x: f32, %offset: f32, %unused: f32):
      %biased = arith.addf %x, %offset : f32
      %activated = arith.maximumf %biased, %zero : f32
      linalg.yield %activated : f32
    } -> tensor<2x2xf32>
    return %result : tensor<2x2xf32>
  }
}

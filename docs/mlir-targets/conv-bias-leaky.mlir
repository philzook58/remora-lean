// Handwritten target, not yet generated by Remora.
// NCHW input, FCHW filters; cross-correlation (no kernel flip).
// Padding = 1 on each spatial side; stride = 2; dilation = 1.
module {
  func.func @main(%input: tensor<1x1x3x3xf32>, %filter: tensor<2x1x3x3xf32>,
                  %bias: tensor<2xf32>) -> tensor<1x2x2x2xf32> {
    %zero = arith.constant 0.0 : f32
    %slope = arith.constant 0.1 : f32
    %padded = tensor.pad %input low[0,0,1,1] high[0,0,1,1] {
    ^bb0(%n: index, %c: index, %h: index, %w: index):
      tensor.yield %zero : f32
    } : tensor<1x1x3x3xf32> to tensor<1x1x5x5xf32>
    %empty = tensor.empty() : tensor<1x2x2x2xf32>
    %init = linalg.fill ins(%zero : f32) outs(%empty : tensor<1x2x2x2xf32>)
      -> tensor<1x2x2x2xf32>
    %conv = linalg.conv_2d_nchw_fchw {
      strides = dense<2> : tensor<2xi64>,
      dilations = dense<1> : tensor<2xi64>
    } ins(%padded, %filter : tensor<1x1x5x5xf32>, tensor<2x1x3x3xf32>)
      outs(%init : tensor<1x2x2x2xf32>) -> tensor<1x2x2x2xf32>
    %dest = tensor.empty() : tensor<1x2x2x2xf32>
    %result = linalg.generic {
      indexing_maps = [affine_map<(n,f,h,w)->(n,f,h,w)>,
                       affine_map<(n,f,h,w)->(f)>,
                       affine_map<(n,f,h,w)->(n,f,h,w)>],
      iterator_types = ["parallel", "parallel", "parallel", "parallel"]
    } ins(%conv, %bias : tensor<1x2x2x2xf32>, tensor<2xf32>)
      outs(%dest : tensor<1x2x2x2xf32>) {
    ^bb0(%x: f32, %offset: f32, %unused: f32):
      %biased = arith.addf %x, %offset : f32
      %negative = arith.mulf %biased, %slope : f32
      %activated = arith.maximumf %biased, %negative : f32
      linalg.yield %activated : f32
    } -> tensor<1x2x2x2xf32>
    return %result : tensor<1x2x2x2xf32>
  }
}
